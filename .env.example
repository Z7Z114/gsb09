# 复制为 .env 后按需填写；全部留空时后端走离线分支，可无网络运行。
DATABASE_URL=sqlite:///./data/gongdao.db

# 可选：OpenAI 工艺档案摘要（留空则用确定性离线摘要）
OPENAI_API_KEY=

# 可选：pyannote 说话人分离（留空则用离线分段）
PYANNOTE_AUTH_TOKEN=

# 可选：邮件（SMTP）。留空时 send-email 会如实返回未投递。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=feiyi_protection@example.org
